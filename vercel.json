{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/lavori", "destination": "/portfolio", "permanent": true },
    { "source": "/backoffice", "destination": "https://v0-giraffa-consulting.vercel.app/backoffice", "permanent": false },
    { "source": "/backoffice/:path*", "destination": "https://v0-giraffa-consulting.vercel.app/backoffice/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
